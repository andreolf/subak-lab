{
  "name": "subak-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Free, no-sign-up interactive lab of a Balinese rice-terrace (subak) cascade: weirs, mass balance, hydrostatics, erosion (Francesco Andreoli).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node serve.mjs dist 4173",
    "preview": "node serve.mjs dist 4173",
    "test:e2e": "node test/e2e.mjs",
    "test:pages": "SUBPATH=/subak-lab NO_SHOTS=1 node test/e2e.mjs",
    "test:live": "BASE=https://andreolf.github.io/subak-lab SHOT_PREFIX=live- node test/e2e.mjs",
    "test": "npm run build && npm run test:e2e && npm run test:pages"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andreolf/subak-lab.git"
  },
  "homepage": "https://andreolf.github.io/subak-lab/"
}
